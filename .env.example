# --- Vector DB ---
VECTOR_DB_HOST=vector-db
VECTOR_DB_PORT=6333
VECTOR_DB_COLLECTION=legal_articles

# --- Session store (SQLite file, mounted volume, no separate container) ---
SESSION_DB_PATH=/data/crawler_state/session.db

# --- Embedding model ---
EMBEDDING_MODEL=keepitreal/vietnamese-sbert

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-base
# Calibrated for bge-reranker-base; re-run eval/run_eval.py if the reranker changes
RERANK_RELEVANCE_THRESHOLD=0.3

# --- LLM engine (runs OUTSIDE docker-compose, e.g. Ollama on the host) ---
LLM_PROVIDER=ollama        # ollama | external_api
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 3b fits a 4 GB GPU; 7b needs >= 8 GB VRAM for the < 10 s target (see config.py)
OLLAMA_MODEL=qwen2.5:3b-instruct
EXTERNAL_LLM_API_KEY=

# --- Crawler (document list: DOCUMENTS in crawler/crawler/sources/luatvietnam.py) ---
CRAWLER_STATE_DIR=/data/crawler_state

# --- Backend ---
BACKEND_PORT=8000
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
